	(hierarchical_label "HALOW_ANT"
		(shape bidirectional)
		(at 50.8 101.6 180)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "f3c066d6-ebb2-415e-bb4d-3f84ca459b0b")
	)
	(text "HaLow 902-928 MHz output: 100 pF DC block (Heltec SDIO reference), then a 5-pole LC low-pass for the 3rd harmonic near 2.75 GHz.\nSimulated with LQW15AN8N2 limits (Q >= 25 at 250 MHz, SRF >= 5.5 GHz): 0.3-0.6 dB loss at 915 MHz, -20 dB at 2fo, -44 dB at 3fo.\nTune on the first board (VNA, spectrum analyser); the shunt pads double as the antenna match. 50 ohm CPWG over solid ground.\nESP32-C5 antenna: the module's own U.FL (ANT1). GPS antenna: U.FL on the GPS sheet. Keep the three antennas apart."
		(exclude_from_sim no)
		(at 50.8 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9c5a6441-45a7-44b5-8998-83176e59e2f4")
	)
